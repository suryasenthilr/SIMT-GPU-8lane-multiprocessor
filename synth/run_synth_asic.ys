# ==============================================================================
# Yosys ASIC Synthesis Script for Apex-GPU Top Streaming Multiprocessor
# Target Library: Nangate 45nm Open Cell Library (NangateOpenCellLibrary_typical.lib)
# ==============================================================================

read_verilog -sv rtl/simt_divergence_stack.v
read_verilog -sv rtl/warp_scheduler.v
read_verilog -sv rtl/simd_lane.v
read_verilog -sv rtl/matrix_unit.v
read_verilog -sv rtl/memory_coalescer.v
read_verilog -sv rtl/shared_memory.v
read_verilog -sv rtl/axi4_master_interface.v
read_verilog -sv rtl/apex_gpu_top.v

# Elaborate & Flatten Hierarchy
hierarchy -check -top apex_gpu_top
synth -top apex_gpu_top -flatten

# Technology Mapping to Nangate 45nm
dfflibmap -liberty synth/nangate45.lib
abc -liberty synth/nangate45.lib

clean
stat -liberty synth/nangate45.lib
write_verilog -noattr synth/apex_gpu_nangate45_netlist.v
